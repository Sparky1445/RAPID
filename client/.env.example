# Google Maps — client-side, so this key ships inside the built bundle.
# Restrict it in Google Cloud Console (HTTP referrer + Maps JavaScript API
# only). Copy this file to .env and fill in the values; .env is gitignored.
VITE_GOOGLE_MAPS_API_KEY=
# Map ID enables Advanced Markers and cloud styling. Not a secret.
VITE_GOOGLE_MAPS_MAP_ID=
